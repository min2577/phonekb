{
  "version": 2,
  "id": "terminal",
  "name": "终端 / Shell",
  "icon": "⬛",
  "built_in": true,
  "match": {
    "process": [
      "WindowsTerminal.exe",
      "powershell.exe",
      "cmd.exe",
      "pwsh.exe"
    ],
    "title_contains": []
  },
  "pages": [
    {
      "id": "shell",
      "name": "Shell",
      "icon": "🐚",
      "slots": [
        {
          "r": 0,
          "c": 0,
          "span": 1,
          "key": {
            "id": "term_l",
            "label": "清屏",
            "sub": "Ctrl+L",
            "icon": "🧹",
            "type": "shortcut",
            "feedback": {
              "vibrate": true,
              "sound": false,
              "toast": false
            },
            "shortcut": {
              "modifiers": [
                "ctrl"
              ],
              "key": "l"
            }
          }
        },
        {
          "r": 0,
          "c": 1,
          "span": 1,
          "key": {
            "id": "term_c",
            "label": "终止",
            "sub": "Ctrl+C",
            "icon": "⛔",
            "type": "shortcut",
            "feedback": {
              "vibrate": true,
              "sound": false,
              "toast": true
            },
            "shortcut": {
              "modifiers": [
                "ctrl"
              ],
              "key": "c"
            }
          }
